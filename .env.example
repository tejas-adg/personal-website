# Server-only environment variables. Copy to .env locally; never commit actual secrets.
# Deno Deploy: configure these in app Settings > Environment Variables.
AUTH_ORIGIN=https://tejasam.com
AUTH_DEV_ORIGIN=http://localhost:5173
AUTH_TABLE_NAME=
AUTH_STORE_URL=
AUTH_STORE_SECRET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
# Enable a provider only AFTER configuring it in Cognito and the app client.
AUTH_PROVIDERS=Google
AUTH_SESSION_SECONDS=28800
AUTH_RECENT_SECONDS=900
# The AWS store endpoint accepts only signed server-to-server requests.
# Keep AUTH_STORE_SECRET and COGNITO_CLIENT_SECRET out of browser code and Git.
