{
  "nodeModulesDir": "manual",
  "tasks": {
    "test": "deno test lib/auth",
    "test:infra": "deno test --config infra/deno.json --allow-read infra/auth-store-handler_test.ts",
    "check": "deno fmt --check . && deno lint . && deno check && deno task check:infra",
    "check:infra": "deno fmt --check --config infra/deno.json infra && deno lint --config infra/deno.json infra && deno check --config infra/deno.json infra/auth-store-handler_test.ts",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server/server-entry.mjs",
    "update": "deno run -A -r --node-modules-dir=auto jsr:@fresh/update ."
  },
  "lint": { "rules": { "tags": ["fresh", "recommended"] } },
  "exclude": [
    "**/_fresh/*",
    "infra/auth-store-handler.cjs",
    "infra/auth-store-handler_test.ts"
  ],
  "imports": {
    "@aws-sdk/client-dynamodb": "npm:@aws-sdk/client-dynamodb@^3.1154.0",
    "@aws-sdk/lib-dynamodb": "npm:@aws-sdk/lib-dynamodb@^3.1154.0",
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.8",
    "@preact/signals": "npm:@preact/signals@^2.11.3",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.3.7",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  },
  "deploy": {
    "org": "tejas-adg",
    "app": "personal-website"
  }
}
